TERA_PORT=4173
TERA_HOST=127.0.0.1
# Comma-separated HTTPS hosts the PDF relay may fetch from.
TERA_ALLOWED_PDF_HOSTS=pastpapers.papacambridge.com
# Optional comma-separated browser origins allowed to call /api/pdf.
# Leave unset for same-origin only.
TERA_ALLOWED_ORIGINS=
# Public HTTPS origin used for canonical links, Open Graph, robots.txt, and sitemap.xml.
TERA_PUBLIC_URL=
# Optional durable first-party usage counter. Keep the secret on the server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
