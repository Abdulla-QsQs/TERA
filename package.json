{
  "name": "tera-past-paper-compiler",
  "version": "0.1.0",
  "private": true,
  "description": "Paper-efficient past-paper booklet compiler",
  "license": "MIT",
  "author": "ZEROCTRL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdulla-QsQs/TERA.git"
  },
  "bugs": {
    "url": "https://github.com/Abdulla-QsQs/TERA/issues"
  },
  "homepage": "https://tera-paper-compiler.pages.dev/",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:pages": "node scripts/build-pages.js",
    "vendor": "node scripts/vendor.js",
    "check:vendor": "node scripts/check-vendor.js",
    "check:cloudflare": "node scripts/check-cloudflare.js",
    "check:pages": "npm run build:pages && node scripts/check-pages-output.js",
    "check": "node --check server.js && node --check visitor-store.js && node --check runtime-manifest.js && node --check wall.js && node scripts/check-html.js && npm run check:vendor && npm run check:cloudflare && npm run check:pages",
    "test": "node tests/run.js",
    "test:all": "npm run check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  }
}
